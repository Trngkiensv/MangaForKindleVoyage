{
  "name": "kindle-voyage-manga-reader",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "pg": "^8.16.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "sharp": "^0.34.3",
    "whatwg-fetch": "^3.6.20",
    "@lingo-reader/epub-parser": "^0.4.6",
    "@lingo-reader/mobi-parser": "^0.4.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@vitejs/plugin-legacy": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.39.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "browserslist": [
    "ie >= 11",
    "Safari >= 8",
    "Android >= 4.4"
  ]
}
