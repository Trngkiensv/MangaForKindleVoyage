# Active backend data provider
# Options: weebcentral | mangafire | mangakatana | mangadex
MANGA_PROVIDER=mangakatana

# Optional: override WeebCentral base URL (useful for testing/mirrors)
WEEBCENTRAL_BASE_URL=https://weebcentral.com/
# Optional provider base URL overrides. Defaults already match the public sites.
MANGAFIRE_BASE_URL=https://mangafire.to/
MANGAKATANA_BASE_URL=https://mangakatana.com/

# English -> Vietnamese live manga translation (Node server only)
MANGA_TRANSLATION=true

# OCR.Space Free API key. Register at https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your-ocr-space-key
# Free OCR.Space has a 1 MB upload limit. The server automatically creates an
# OCR-only grayscale JPEG and shrinks it until it fits. 1600 is a good default.
OCR_SPACE_MAX_WIDTH=1600
# 1, 2, or 3. Engine 2 is the default for overlay coordinates in this build.
OCR_SPACE_ENGINE=2

# Cloudflare Workers AI REST API credentials.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
# Instruction LLM used for manga-aware EN -> VI translation.
CLOUDFLARE_MANGA_LLM_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Maximum response size for translating one full manga page. Qwen3 can spend
# part of this budget on reasoning, so 3072 is safer than 2048.
CLOUDFLARE_MAX_TOKENS=3072
# Optional one-shot page fallback. It is NOT used while TRANSLATION_ALLOW_FALLBACK=false.
CLOUDFLARE_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Translation warm-ahead. Current page is immediate; 2 warms the next two pages.
TRANSLATION_PREFETCH_AHEAD=2
# Optional persistent OCR/translation JSON cache location.
# TRANSLATION_CACHE_DIR=.cache/en-vi-translation

# Quota saver: false = one Qwen request per page, no Llama/per-region retry.
TRANSLATION_ALLOW_FALLBACK=false

# ---------------- Account + reading sync (Neon PostgreSQL) ----------------
# Keep this server-side only. Copy the pooled Neon connection string from Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Persistent login cookie lifetime. Kindle remembers the login with a tiny
# HttpOnly cookie; history/progress/saved manga are NOT stored in localStorage.
AUTH_SESSION_DAYS=90
# Required to protect 6-digit password-reset codes. Generate a long random value,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret
# Reset codes expire after this many minutes.
AUTH_RESET_CODE_TTL_MINUTES=10

# Password reset email - choose ONE provider.
# Recommended simple option: Brevo transactional email API.
BREVO_API_KEY=
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIL_FROM_NAME=Manga Kindle

# Alternative: Resend. For sending to real users, configure an allowed/verified sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Manga Kindle <noreply@example.com>

# Local production testing over plain HTTP only. Do NOT set false on Render HTTPS.
# AUTH_COOKIE_SECURE=false

# Optional Google Drive text-book library (EPUB/AZW3)
# Share the configured Drive folder with the service account client_email as Viewer.
GOOGLE_DRIVE_FOLDER_ID=
# Paste either the raw service-account JSON or a Base64 encoding of the JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
BOOK_LIBRARY_CACHE_SECONDS=60
BOOK_PARSE_CACHE_LIMIT=3
BOOK_MAX_FILE_MB=80
